# Credenciais do GitHub App para o serviço github
# Copiar para .env.github e preencher os valores reais
#
# Como gerar a Private Key:
# 1. Acesse https://github.com/settings/apps/os-tasks
# 2. Clique em "Generate a private key"
# 3. Baixe o arquivo .pem
# 4. Converta para uma linha só (Linux/Mac):
#      awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' arquivo.pem
# 5. Cole o resultado abaixo (começa com -----BEGIN RSA PRIVATE KEY-----\n...)

APP_ID=3772028
CLIENT_ID=Iv23liz1iroLtzYJl96V
CLIENT_SECRET=
PRIVATE_KEY=
# WEBHOOK_SECRET é opcional (padrão: secret)
WEBHOOK_SECRET=
