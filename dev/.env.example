# Arquivo de ambiente padrão do docker-compose (dev/). Copie para dev/.env e
# ajuste os valores. NÃO coloque segredos reais aqui nem em dev/.env versionado.
#
# Segredos de verdade (Gmail/SMTP, 3F Core API key, GitHub App, LiveKit, Google
# OAuth) NÃO ficam aqui — vão em dev/.env.secrets, injetado via `env_file` no
# docker-compose e nunca versionado. Veja dev/.env.secrets.example.

# Storage de blobs (datalake) — hostname interno, não é segredo
STORAGE_CONFIG="datalake|http://datalake:4030"

# Bancos — troque usuário/senha pelos do seu ambiente local
MONGO_URL=mongodb://mongodb:27017?compressors=snappy
DB_URL_PG=postgres://<user>:<password>@postgres:5432/postgres
DB_CR_URL=postgresql://<user>@cockroach:26257/defaultdb?sslmode=disable

# Backup em MinIO — preencha com suas chaves locais
BACKUP_STORAGE_CONFIG="minio|minio?accessKey=<ACCESS_KEY>&secretKey=<SECRET_KEY>"
BACKUP_BUCKET_NAME=dev-backups

# Fila (Redpanda/Kafka) — hostname interno
QUEUE_CONFIG=redpanda:9092

# E-mails com privilégio de admin da plataforma (separados por vírgula)
PLATFORM_ADMIN_EMAILS=admin@example.com

# Billing (Polar) — deixe vazio se não usar
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SUBSCRIPTION_PLANS=
