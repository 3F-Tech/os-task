# Credenciais secretas — NÃO commitar o arquivo .env.secrets
# Copiar este arquivo para .env.secrets e preencher os valores
#
# Como criar as credenciais do Google:
# 1. Acesse https://console.cloud.google.com
# 2. Crie um projeto → Ative a Google Calendar API
# 3. Credenciais → Criar credencial → OAuth 2.0 (Aplicativo Web)
# 4. URI de redirecionamento autorizado: https://3ftasks.3fventure.tech:8095/signin/code
# 5. Baixe o JSON → converta para uma linha só (sem quebras de linha)
#    PowerShell: (Get-Content credentials.json -Raw) -replace '\r?\n',''
#    Linux/Mac:  cat credentials.json | tr -d '\n'

Credentials=COLE_AQUI_O_JSON_DO_GOOGLE_EM_UMA_LINHA_SÓ

# Credenciais do LiveKit (feature Office / chamadas)
# Gerar com:
#   API_KEY: openssl rand -hex 8        (16 chars hex)
#   API_SECRET: openssl rand -hex 32    (64 chars hex)
# Ambos os valores são usados pelo container livekit e pelo serviço love.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Credenciais do GitHub App (OS Tasks)
# App ID e Client ID são públicos (também estão no config.json)
# Client Secret e Private Key são secretos — nunca commitar
GITHUB_APP_ID=3772028
GITHUB_CLIENT_ID=Iv23liz1iroLtzYJl96V
GITHUB_CLIENT_SECRET=
# Private Key: cole o conteúdo do .pem em uma única linha, substituindo quebras de linha por \n
# Exemplo: -----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
GITHUB_PRIVATE_KEY=
# Webhook Secret: string que você definiu (ou deixe vazio por enquanto)
GITHUB_WEBHOOK_SECRET=

# ── E-mail (Gmail SMTP) ───────────────────────────────────────────────────────
# Injetado diretamente no container `mail` via env_file. Use exatamente
# os nomes abaixo — eles são as variáveis que o pod-mail lê.
#
# Pré-requisitos no Gmail:
#   1. Conta com 2FA habilitado.
#   2. Gerar uma "Senha de app" em https://myaccount.google.com/apppasswords
#      (a senha normal do Gmail NÃO funciona via SMTP).
#   3. SOURCE precisa ser o próprio endereço autenticado em SMTP_USERNAME
#      (ou um alias verificado dentro do Google Workspace).
#
# SOURCE         — endereço "From:" dos e-mails enviados
# REPLY_TO       — endereço para o qual respostas devem ir (opcional)
# SMTP_USERNAME  — login SMTP (geralmente igual ao SOURCE)
# SMTP_PASSWORD  — senha de app de 16 caracteres gerada acima
SOURCE=noreply@3fventure.com.br
REPLY_TO=
SMTP_USERNAME=
SMTP_PASSWORD=
